---
import type { Project } from "../data/projects"
import { projects } from "../data/projects"
import ProjectLinks from "../components/ProjectLinks.astro"
import DownloadSection from "../components/DownloadSection.astro"
import ProjectMetadata from "../components/ProjectMetadata.astro"
import RelatedProjects from "../components/RelatedProjects.astro"
import { getProjectAccent, getRelatedProjects } from "../lib/projectPresentation"

export interface Props { project: Project }
const { project } = Astro.props
const accent = getProjectAccent(project)
const relatedProjects = getRelatedProjects(project, projects)
---

<section class="page-refresh mx-auto max-w-6xl px-4 pb-16 pt-28 sm:px-6 sm:pb-24 sm:pt-36">
  <a href="/projects" class="mono text-sm text-dim transition-colors hover:text-fg">← all projects</a>

  <div class="mt-10 grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
    <div>
      <div class="flex flex-wrap items-center gap-3 sm:gap-4">
        <span class="text-4xl" aria-hidden="true">{project.emoji}</span>
        <h1 class="min-w-0 break-words text-4xl font-light tracking-[-0.05em] text-fg sm:text-7xl">{project.name}<span style={`color: ${accent}`}>.</span></h1>
      </div>
      <p class="mt-6 max-w-2xl text-xl font-light leading-relaxed text-dim">{project.tagline}</p>
    </div>

    <ProjectMetadata project={project} />
  </div>

  <div class="mt-16 grid gap-12 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="eyebrow">why it matters</p>
      <div class="mt-5 border-l-2 pl-5 text-base leading-relaxed text-dim" style={`border-color: ${accent}`}>
        <p>{project.fullDescription}</p>
      </div>
    </div>

    {project.highlights && (
      <div>
        <p class="eyebrow">what shipped</p>
        <ul class="mt-5 space-y-3">
          {project.highlights.map((highlight) => (
            <li class="flex items-start gap-3 text-sm leading-relaxed text-dim">
              <span class="mt-1 text-xs" style={`color: ${accent}`}>◆</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  {project.links && project.links.length > 0 && <ProjectLinks links={project.links} accent={accent} />}
  {project.downloadManifestUrl && <DownloadSection accent={accent} manifestUrl={project.downloadManifestUrl} />}

  <RelatedProjects projects={relatedProjects} />
</section>
