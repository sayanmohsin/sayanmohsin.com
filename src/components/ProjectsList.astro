---
import ProjectShowcase from "./ProjectShowcase.astro"
---

<div class="projects-page-intro mx-auto max-w-6xl px-4 pt-28 sm:px-6 sm:pt-36">
  <div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <p class="eyebrow">selected work / 2023—now</p>
      <h1 class="mt-4 text-4xl font-light tracking-[-0.06em] text-fg sm:text-6xl">projects with<br />different jobs<span class="text-signal">.</span></h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-dim">A collection of products, tools, and experiments. Browse the work, then open a project for the full story.</p>
    </div>
    <div class="mono text-xs text-dim"><span class="status-dot mr-2" aria-hidden="true"></span>shipping in public</div>
  </div>
</div>

<ProjectShowcase />
