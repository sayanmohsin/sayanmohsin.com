---
import { projects } from "../data/projects"
---

<section class="mx-auto max-w-6xl px-4 pb-16 pt-28 sm:px-6 sm:pb-24 sm:pt-36">
  <div class="flex flex-col justify-between gap-8 sm:flex-row sm:items-end">
    <div class="max-w-2xl">
      <p class="eyebrow">selected work / 2023—now</p>
      <h1 class="mt-4 text-4xl font-light tracking-[-0.04em] text-fg sm:text-6xl">Things I've built<span class="text-signal">.</span></h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-dim">Tools, engines, and experiments for making software more capable without making it harder to understand.</p>
    </div>
    <div class="mono text-xs text-dim"><span class="status-dot mr-2" aria-hidden="true"></span>shipping in public</div>
  </div>

  <div class="mt-12 grid gap-5 lg:grid-cols-2">
    {projects.map((p) => (
      <a
        href={`/projects/${p.slug}`}
        class:list={{ "project-card group rounded-2xl p-5 sm:p-7": true, "lg:col-span-2": p.featured }}
        style={`--card-accent: ${p.accent ?? "#ff6b00"}`}
      >
        <div class="relative z-10 flex h-full flex-col">
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-black/20 text-xl" aria-hidden="true">{p.emoji}</span>
              <div>
                <h2 class="text-2xl font-medium tracking-tight text-fg group-hover:text-signal transition-colors">{p.name}</h2>
              </div>
            </div>
            <span class="text-xl text-dim transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span>
          </div>

          <p class="mt-6 max-w-2xl text-base leading-relaxed text-dim">{p.tagline}</p>

          <div class="mt-7 grid grid-cols-2 gap-2 sm:max-w-md">
            {(p.metrics ?? []).map((metric) => (
              <div class="metric-card" style={`--metric-accent: ${p.accent ?? "#ff6b00"}`}>
                <p class="text-lg font-medium text-fg">{metric.value}</p>
                <p class="mono mt-1 text-[10px] uppercase tracking-[0.08em] text-dim">{metric.label}</p>
              </div>
            ))}
          </div>

          <div class="mt-7 flex flex-wrap gap-2 mono text-[11px] text-dim/75">
            {p.tags.map((tag) => <span class="rounded-full border border-white/10 px-2.5 py-1">{tag}</span>)}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
