---
import type { Project } from "../data/projects"
import ProjectNode from "./ProjectNode.astro"

interface Props {
  projects: Project[]
}

const { projects } = Astro.props
---

{projects.length > 0 && (
  <div class="mt-16 border-t border-line pt-7">
    <p class="eyebrow">more projects</p>
    <div class="related-project-list mt-4">
      {projects.map((project, index) => <ProjectNode project={project} index={index} variant="compact" />)}
    </div>
  </div>
)}
