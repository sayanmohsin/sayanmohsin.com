---
import type { Project } from "../data/projects"
import { projects as catalog } from "../data/projects"
import { getProjectStatus } from "../lib/projectPresentation"
import ProjectNode from "./ProjectNode.astro"

export interface Props {
  mode: "home" | "dashboard" | "detail"
  projects?: Project[]
  project?: Project
}

const { mode, projects = catalog, project } = Astro.props
const graphId = `project-graph-${mode}-${project?.slug ?? "catalog"}`
const graphProjects = mode === "home" ? projects.slice(0, 3) : projects
const detailNodes = project
  ? [
      { label: project.tagline, kind: "tagline", accent: project.accent ?? "#e86f35" },
      ...(project.status ? [{ label: project.status, kind: "status", accent: project.accent ?? "#e86f35" }] : []),
      ...(project.metrics ?? []).slice(0, 2).map((metric) => ({ label: `${metric.value} · ${metric.label}`, kind: "metric", accent: project.accent ?? "#e86f35" })),
      ...project.tags.slice(0, 3).map((tag) => ({ label: tag, kind: "tag", accent: project.accent ?? "#e86f35" })),
      ...(project.highlights ?? []).slice(0, 2).map((highlight) => ({ label: highlight, kind: "highlight", accent: project.accent ?? "#e86f35" })),
    ]
  : []
const nodeCount = mode === "detail" ? detailNodes.length + 1 : graphProjects.length
---

<section id={graphId} class:list={{ "project-graph": true, "project-graph--home": mode === "home", "project-graph--dashboard": mode === "dashboard", "project-graph--detail": mode === "detail" }} data-graph-mode={mode} aria-label={mode === "detail" ? `${project?.name} project shape` : "project constellation"}>
  <canvas class="project-graph__canvas" aria-hidden="true"></canvas>
  <div class="project-graph__tiles" aria-hidden="true">
    <span class="project-graph__tile project-graph__tile--one"></span>
    <span class="project-graph__tile project-graph__tile--two"></span>
    <span class="project-graph__tile project-graph__tile--three"></span>
    <span class="project-graph__tile project-graph__tile--four"></span>
  </div>

  <div class="project-graph__heading mono">
    <span>{mode === "detail" ? "project shape" : mode === "home" ? "selected work" : "all projects"}</span>
    <span>{mode !== "detail" ? "thingd / powering the work" : `${String(nodeCount).padStart(2, "0")} nodes`}</span>
  </div>

  <div class="project-graph__nodes">
    {mode === "detail" && project ? (
      <ProjectNode project={project} index={0} selected variant="graph" />
    ) : (
      graphProjects.map((item, index) => (
        <ProjectNode project={item} index={index} variant="graph" />
      ))
    )}

    {mode === "detail" && detailNodes.map((node) => (
      <span class={`project-graph__node project-graph__node--meta project-graph__node--${node.kind}`} data-node-kind={node.kind} data-project-accent={node.accent} style={`--graph-accent: ${node.accent}`}>
        <span class="project-graph__meta-mark" aria-hidden="true"></span>
        <span>{node.label}</span>
      </span>
    ))}
  </div>

  {mode === "dashboard" && (
    <aside class="project-graph__preview" aria-live="polite">
      <span class="project-graph__preview-label mono">selected project</span>
      <div class="project-graph__preview-title"><span id={`${graphId}-emoji`} aria-hidden="true">{graphProjects[0]?.emoji}</span><h3 id={`${graphId}-name`}>{graphProjects[0]?.name}</h3></div>
      <p id={`${graphId}-tagline`}>{graphProjects[0]?.tagline}</p>
      <div id={`${graphId}-meta`} class="project-graph__preview-meta mono">{graphProjects[0]?.status ?? "in progress"}</div>
      <a id={`${graphId}-link`} href={`/projects/${graphProjects[0]?.slug}`} class="project-graph__preview-link">open project <span aria-hidden="true">↗</span></a>
    </aside>
  )}

  <p class="project-graph__fallback mono">open a node to explore the full project</p>
</section>

<script id={`${graphId}-data`} type="application/json" set:html={JSON.stringify(graphProjects)}></script>

<script>
  import { Application, Graphics } from "pixi.js"

  const graph = document.querySelector<HTMLElement>(".project-graph")
  const graphId = graph?.id ?? ""
  const mode = graph?.dataset.graphMode ?? "home"
  const canvas = graph?.querySelector<HTMLCanvasElement>(".project-graph__canvas")
  const nodes = Array.from(graph?.querySelectorAll<HTMLElement>(".project-graph__node") ?? [])
  const data = JSON.parse(document.getElementById(`${graphId}-data`)?.textContent ?? "[]")
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

  if (graph && canvas && nodes.length > 0) {
    let points: Array<{ x: number; y: number; accent: number }> = []
    let selectedIndex = 0
    let visible = !document.hidden
    let inViewport = true
    let destroyed = false
    let tickerAttached = false
    let pulse = 0
    const pointer = { x: 0, y: 0 }
    const parseAccent = (value: string) => Number.parseInt(value.replace("#", ""), 16) || 0xe86f35

    const start = async () => {
      const app = new Application()
      await app.init({ canvas, resizeTo: graph, backgroundAlpha: 0, antialias: true, autoDensity: true, resolution: Math.min(window.devicePixelRatio, 1.5) })
      const paths = new Graphics()
      const flow = new Graphics()
      const particles = new Graphics()
      const marks = new Graphics()
      app.stage.addChild(paths, flow, particles, marks)

      const measure = () => {
        const graphBounds = graph.getBoundingClientRect()
        points = nodes.map((node) => {
          const bounds = node.getBoundingClientRect()
          return { x: bounds.left - graphBounds.left + bounds.width / 2, y: bounds.top - graphBounds.top + bounds.height / 2, accent: parseAccent(node.dataset.projectAccent ?? "#e86f35") }
        })
      }

      const draw = (time = 0) => {
        const width = graph.clientWidth
        const height = graph.clientHeight
        if (!width || !height) return
        measure()
        const motion = reducedMotion ? 0 : time * 0.001
        const driftX = pointer.x * 4
        const driftY = pointer.y * 3
        pulse = Math.max(0, pulse - 0.025)
        const origin = points[0]
        const curvePoint = (start: { x: number; y: number }, end: { x: number; y: number }, progress: number) => {
          const bendX = (start.x + end.x) / 2
          const bendY = Math.min(start.y, end.y) - Math.min(30, height * 0.04)
          if (progress < 0.5) {
            const t = progress * 2
            return { x: start.x + (bendX - start.x) * t, y: start.y + (bendY - start.y) * t }
          }
          const t = (progress - 0.5) * 2
          return { x: bendX + (end.x - bendX) * t, y: bendY + (end.y - bendY) * t }
        }

        paths.clear()
        flow.clear()
        if (origin && points.length > 1) {
          points.slice(1).forEach((point) => {
            const bendX = (origin.x + point.x) / 2
            const bendY = Math.min(origin.y, point.y) - Math.min(30, height * 0.04)
            paths.moveTo(origin.x + driftX * 0.35, origin.y + driftY * 0.35)
            paths.quadraticCurveTo(bendX + driftX * 0.35, bendY + driftY * 0.35, point.x + driftX * 0.35, point.y + driftY * 0.35)
            paths.stroke({ color: point.accent, alpha: mode !== "detail" ? 0.2 + pulse * 0.1 : 0.13 + pulse * 0.08, width: mode !== "detail" ? 1.2 : 1 })

            if (mode !== "detail") {
              flow.moveTo(origin.x + driftX * 0.35, origin.y + driftY * 0.35)
              flow.quadraticCurveTo(bendX + driftX * 0.35, bendY + driftY * 0.35, point.x + driftX * 0.35, point.y + driftY * 0.35)
              flow.stroke({ color: origin.accent, alpha: 0.08, width: 3 })
            }
          })
        }

        particles.clear()
        if (origin && points.length > 1 && !reducedMotion) {
          points.slice(1).forEach((point, index) => {
            for (let lane = 0; lane < (mode !== "detail" ? 2 : 1); lane += 1) {
              const progress = (motion * (mode !== "detail" ? 0.055 : 0.07) + index * 0.29 + lane * 0.47) % 1
              const packet = curvePoint(origin, point, progress)
              const nextPacket = curvePoint(origin, point, Math.min(1, progress + 0.025))
              const packetX = packet.x + driftX * 0.35
              const packetY = packet.y + driftY * 0.35
              for (let trail = 3; trail >= 0; trail -= 1) {
                const trailProgress = Math.max(0, progress - trail * 0.035)
                const position = curvePoint(origin, point, trailProgress)
                particles.circle(position.x + driftX * 0.35, position.y + driftY * 0.35, trail === 0 ? 3.2 : 1.5)
                particles.fill({ color: point.accent, alpha: (trail === 0 ? 0.95 : 0.32) - trail * 0.05 })
              }
              if (mode !== "detail") {
                flow.circle(packetX, packetY, 8)
                flow.fill({ color: point.accent, alpha: 0.09 })
                flow.moveTo(packetX, packetY)
                flow.lineTo(nextPacket.x + driftX * 0.35, nextPacket.y + driftY * 0.35)
                flow.stroke({ color: point.accent, alpha: 0.8, width: 1.5 })
              }
            }

            if (mode !== "detail") {
              const arrival = 0.5 + Math.sin(motion * 2.2 + index) * 0.5
              marks.circle(point.x + driftX * 0.35, point.y + driftY * 0.35, 5 + arrival * 5)
              marks.stroke({ color: point.accent, alpha: 0.12 + arrival * 0.2, width: 1 })
              marks.moveTo(point.x - 5 + driftX * 0.35, point.y - 4 + driftY * 0.35)
              marks.lineTo(point.x + driftX * 0.35, point.y + driftY * 0.35)
              marks.lineTo(point.x - 5 + driftX * 0.35, point.y + 4 + driftY * 0.35)
              marks.stroke({ color: point.accent, alpha: 0.24 + arrival * 0.25, width: 1.2 })
            }
          })
        }

        marks.clear()
        points.forEach((point, index) => {
          const active = index === selectedIndex
          const breathing = Math.sin(motion * 1.4 + index) * 0.5 + 0.5
          marks.circle(point.x + driftX * 0.35, point.y + driftY * 0.35, active ? 4 + pulse * 2 : 1.5 + breathing)
          marks.fill({ color: point.accent, alpha: active ? 0.5 : 0.2 })
          if (active) {
            marks.circle(point.x + driftX * 0.35, point.y + driftY * 0.35, 10 + breathing * 2)
            marks.stroke({ color: point.accent, alpha: 0.16, width: 1 })
          }
        })

        if (mode !== "detail" && origin && !reducedMotion) {
          const sourceBreath = Math.sin(motion * 1.8) * 0.5 + 0.5
          marks.circle(origin.x + driftX * 0.35, origin.y + driftY * 0.35, 7 + sourceBreath * 3)
          marks.stroke({ color: origin.accent, alpha: 0.18 + sourceBreath * 0.12, width: 1 })
          marks.circle(origin.x + driftX * 0.35, origin.y + driftY * 0.35, 3.5 + sourceBreath)
          marks.fill({ color: origin.accent, alpha: 0.75 })
        }
      }

      const render = () => draw(performance.now())
      const syncLoop = () => {
        if (destroyed) return
        const shouldTick = !reducedMotion && visible && inViewport
        if (shouldTick && !tickerAttached) { app.ticker.add(render); tickerAttached = true }
        if (!shouldTick && tickerAttached) { app.ticker.remove(render); tickerAttached = false }
        draw()
      }
      const select = (node: HTMLElement) => {
        const index = nodes.indexOf(node)
        if (index < 0) return
        selectedIndex = index
        pulse = 1
        nodes.forEach((candidate) => candidate.classList.toggle("is-selected", candidate === node))
        if (mode === "dashboard") {
          const item = data.find((entry: { slug: string }) => entry.slug === node.dataset.projectSlug)
          if (item) {
            graph.querySelector<HTMLElement>(`#${graphId}-emoji`)!.textContent = item.emoji
            graph.querySelector<HTMLElement>(`#${graphId}-name`)!.textContent = item.name
            graph.querySelector<HTMLElement>(`#${graphId}-tagline`)!.textContent = item.tagline
            graph.querySelector<HTMLElement>(`#${graphId}-meta`)!.textContent = getProjectStatus(item)
            graph.querySelector<HTMLAnchorElement>(`#${graphId}-link`)!.href = `/projects/${item.slug}`
          }
        }
        window.dispatchEvent(new CustomEvent(mode === "home" ? "home-project-change" : "selected-project-change", { detail: { slug: node.dataset.projectSlug, accent: node.dataset.projectAccent } }))
        draw(performance.now())
      }
      const move = (direction: number) => {
        const next = (selectedIndex + direction + nodes.length) % nodes.length
        nodes[next]?.focus({ preventScroll: true })
      }
      const handlePointerMove = (event: PointerEvent) => {
        const bounds = graph.getBoundingClientRect()
        pointer.x = Math.max(-1, Math.min(1, ((event.clientX - bounds.left) / bounds.width) * 2 - 1))
        pointer.y = Math.max(-1, Math.min(1, ((event.clientY - bounds.top) / bounds.height) * 2 - 1))
      }
      const handlePointerLeave = () => { pointer.x = 0; pointer.y = 0 }
      const handleVisibility = () => { visible = !document.hidden; syncLoop() }
      const handleResize = () => { measure(); draw(performance.now()) }
      const observer = new IntersectionObserver(([entry]) => { inViewport = entry.isIntersecting; syncLoop() })
      const resizeObserver = new ResizeObserver(handleResize)
      const cleanup = () => {
        if (destroyed) return
        destroyed = true
        observer.disconnect(); resizeObserver.disconnect()
        graph.removeEventListener("pointermove", handlePointerMove); graph.removeEventListener("pointerleave", handlePointerLeave)
        window.removeEventListener("resize", handleResize); window.removeEventListener("pagehide", cleanup)
        document.removeEventListener("visibilitychange", handleVisibility)
        if (tickerAttached) app.ticker.remove(render)
        app.destroy(true, { children: true })
      }

      observer.observe(graph); resizeObserver.observe(graph)
      nodes.forEach((node) => {
        node.addEventListener("pointerenter", () => select(node))
        node.addEventListener("focus", () => select(node))
        node.addEventListener("keydown", (event) => {
          if (event.key === "ArrowRight" || event.key === "ArrowDown") { event.preventDefault(); move(1) }
          if (event.key === "ArrowLeft" || event.key === "ArrowUp") { event.preventDefault(); move(-1) }
        })
      })
      graph.addEventListener("pointermove", handlePointerMove, { passive: true }); graph.addEventListener("pointerleave", handlePointerLeave)
      window.addEventListener("resize", handleResize); window.addEventListener("pagehide", cleanup)
      document.addEventListener("visibilitychange", handleVisibility)
      measure(); select(nodes[0]); syncLoop()
    }

    start().catch(() => undefined)
  }
</script>
