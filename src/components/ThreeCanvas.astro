<script>
import * as THREE from "three"

type Persona = {
  id: string
  mode: "normal" | "dark"
  accent: string
  background: { intensity: number; density: number }
}

const canvas = document.getElementById("three-canvas") as HTMLCanvasElement | null
const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches

if (canvas && !prefersReducedMotion) {
  const isMobile = window.innerWidth < 640
  const nodeCount = isMobile ? 8 : 18
  const worldWidth = isMobile ? 7.5 : 11
  const worldHeight = isMobile ? 7.5 : 6.5
  const defaultPersona: Persona = {
    id: "builder",
    mode: "normal",
    accent: "#ff6b00",
    background: { intensity: 1, density: 1 },
  }

  let persona = defaultPersona
  let visible = !document.hidden
  let inViewport = true
  let cleanedUp = false

  try {
    const scene = new THREE.Scene()
    const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 100)
    camera.position.z = 9

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: !isMobile,
      powerPreference: "high-performance",
    })
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.25 : 1.75))
    renderer.setSize(canvas.clientWidth, canvas.clientHeight, false)

    const ambientGeometry = new THREE.PlaneGeometry(30, 20)
    const ambientMaterial = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uMouse: { value: new THREE.Vector2(0, 0) },
        uAccent: { value: new THREE.Color(defaultPersona.accent) },
        uIntensity: { value: defaultPersona.background.intensity },
        uDensity: { value: defaultPersona.background.density },
        uDark: { value: 0 },
      },
      vertexShader: `
        varying vec2 vUv;
        void main() {
          vUv = uv;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec2 uMouse;
        uniform vec3 uAccent;
        uniform float uIntensity;
        uniform float uDensity;
        uniform float uDark;
        varying vec2 vUv;

        void main() {
          vec2 centered = vUv - 0.5;
          centered.x *= 1.35;
          centered += uMouse * 0.004;

          float distanceFromCenter = length(centered);
          float angle = atan(centered.y, centered.x);
          float core = exp(-distanceFromCenter * 5.2);
          float orbitalField = 0.0;
          float orbitalPulse = 0.0;

          for (int i = 0; i < 4; i++) {
            float band = float(i);
            float radius = 0.16 + band * 0.105;
            float wobble = sin(angle * (2.0 + band) + uTime * (0.12 + band * 0.025)) * 0.018;
            float distanceToOrbit = abs(distanceFromCenter - radius - wobble);
            float orbit = exp(-distanceToOrbit * 105.0);
            float arc = smoothstep(0.18, 0.92, sin(angle * (1.5 + band * 0.55) - uTime * (0.28 + band * 0.07) + band * 1.7) * 0.5 + 0.5);
            float pulse = smoothstep(0.86, 1.0, sin(angle - uTime * (0.34 + band * 0.08) + band * 1.3) * 0.5 + 0.5);
            orbitalField += orbit * (0.18 + arc * 0.48);
            orbitalPulse += orbit * pulse;
          }

          float ribbonPath = sin(centered.x * 4.5 + uTime * 0.24) * 0.08;
          float ribbon = exp(-abs(centered.y - ribbonPath) * 38.0) * exp(-distanceFromCenter * 1.8);
          float edgeFade = 1.0 - smoothstep(0.48, 0.82, distanceFromCenter);
          float darkFactor = mix(1.0, 0.58, uDark);
          vec3 glowColor = mix(uAccent, vec3(1.0, 0.78, 0.22), clamp(orbitalPulse * 1.5, 0.0, 1.0));
          vec3 color = glowColor * (core * 0.22 + orbitalField * 0.42 + ribbon * 0.045);
          float alpha = (core * 0.32 + orbitalField * 0.72 + orbitalPulse * 0.32 + ribbon * 0.06) * edgeFade * uIntensity * darkFactor;
          gl_FragColor = vec4(color, alpha);
        }
      `,
      transparent: true,
      depthWrite: false,
      depthTest: false,
    })
    const ambient = new THREE.Mesh(ambientGeometry, ambientMaterial)
    ambient.position.z = -3.2
    scene.add(ambient)

    const nodePositions: THREE.Vector3[] = []
    let seed = 17
    const random = () => {
      seed = (seed * 9301 + 49297) % 233280
      return seed / 233280
    }

    for (let i = 0; i < nodeCount; i += 1) {
      const x = (random() - 0.5) * worldWidth
      const y = (random() - 0.5) * worldHeight
      const z = -0.7 - random() * 1.2
      nodePositions.push(new THREE.Vector3(x, y, z))
    }

    const nodeData = new Float32Array(nodeCount * 3)
    const nodePhases = new Float32Array(nodeCount)
    nodePositions.forEach((position, index) => {
      nodeData[index * 3] = position.x
      nodeData[index * 3 + 1] = position.y
      nodeData[index * 3 + 2] = position.z
      nodePhases[index] = random()
    })

    const nodeGeometry = new THREE.BufferGeometry()
    nodeGeometry.setAttribute("position", new THREE.Float32BufferAttribute(nodeData, 3))
    nodeGeometry.setAttribute("aPhase", new THREE.Float32BufferAttribute(nodePhases, 1))

    const nodeMaterial = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uMouse: { value: new THREE.Vector2(0, 0) },
        uAccent: { value: new THREE.Color(defaultPersona.accent) },
        uIntensity: { value: defaultPersona.background.intensity },
        uDensity: { value: defaultPersona.background.density },
      },
      vertexShader: `
        attribute float aPhase;
        uniform float uTime;
        uniform vec2 uMouse;
        uniform float uIntensity;
        varying float vGlow;

        void main() {
          vec3 pos = position;
          float distanceToMouse = distance(pos.xy, uMouse);
          float ripple = sin(distanceToMouse * 4.5 - uTime * 2.0) * exp(-distanceToMouse * 0.8);
          pos.z += ripple * 0.11 * uIntensity;
          pos.x += sin(uTime * 0.12 + aPhase * 9.0) * 0.025 * uIntensity;
          pos.y += cos(uTime * 0.11 + aPhase * 7.0) * 0.025 * uIntensity;
          vGlow = 0.6 + 0.4 * sin(uTime * 1.2 + aPhase * 12.0);
          vec4 mvPosition = modelViewMatrix * vec4(pos, 1.0);
          gl_PointSize = (2.8 + vGlow * 2.6) * (18.0 / -mvPosition.z);
          gl_Position = projectionMatrix * mvPosition;
        }
      `,
      fragmentShader: `
        uniform vec3 uAccent;
        uniform float uIntensity;
        uniform float uDensity;
        varying float vGlow;

        void main() {
          float distanceFromCenter = distance(gl_PointCoord, vec2(0.5));
          float alpha = 1.0 - smoothstep(0.15, 0.5, distanceFromCenter);
          vec3 color = mix(uAccent * 0.5, vec3(1.0, 0.9, 0.55), vGlow * 0.45);
          gl_FragColor = vec4(color, alpha * 0.72 * uIntensity * uDensity);
        }
      `,
      transparent: true,
      depthWrite: false,
    })
    const nodes = new THREE.Points(nodeGeometry, nodeMaterial)
    scene.add(nodes)

    const linePositions: number[] = []
    const linePhases: number[] = []
    const connectionDistance = isMobile ? 2.7 : 2.5
    for (let i = 0; i < nodePositions.length; i += 1) {
      for (let j = i + 1; j < nodePositions.length; j += 1) {
        if (nodePositions[i].distanceTo(nodePositions[j]) < connectionDistance && linePhases.length / 2 < (isMobile ? 8 : 24)) {
          linePositions.push(...nodePositions[i].toArray(), ...nodePositions[j].toArray())
          const phase = random()
          linePhases.push(phase, phase)
        }
      }
    }

    const lineGeometry = new THREE.BufferGeometry()
    lineGeometry.setAttribute("position", new THREE.Float32BufferAttribute(linePositions, 3))
    lineGeometry.setAttribute("aPhase", new THREE.Float32BufferAttribute(linePhases, 1))

    const lineMaterial = new THREE.ShaderMaterial({
      uniforms: {
        uTime: { value: 0 },
        uMouse: { value: new THREE.Vector2(0, 0) },
        uAccent: { value: new THREE.Color(defaultPersona.accent) },
        uIntensity: { value: defaultPersona.background.intensity },
        uDensity: { value: defaultPersona.background.density },
        uDark: { value: 0 },
      },
      vertexShader: `
        attribute float aPhase;
        uniform float uTime;
        uniform vec2 uMouse;
        uniform float uIntensity;
        varying float vPhase;

        void main() {
          vec3 pos = position;
          float distanceToMouse = distance(pos.xy, uMouse);
          float ripple = sin(distanceToMouse * 4.0 - uTime * 2.0) * exp(-distanceToMouse * 0.7);
          pos.z += ripple * 0.08 * uIntensity;
          vPhase = aPhase;
          gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
        }
      `,
      fragmentShader: `
        uniform float uTime;
        uniform vec3 uAccent;
        uniform float uIntensity;
        uniform float uDensity;
        uniform float uDark;
        varying float vPhase;

        void main() {
          float pulse = smoothstep(0.82, 1.0, sin(vPhase * 20.0 + uTime * (1.3 + uIntensity)) * 0.5 + 0.5);
          float alpha = (0.07 + pulse * (0.18 + uIntensity * 0.16)) * uDensity * mix(1.0, 0.68, uDark);
          vec3 color = mix(uAccent * 0.55, vec3(1.0, 0.78, 0.25), pulse * 0.5);
          gl_FragColor = vec4(color, alpha);
        }
      `,
      transparent: true,
      depthWrite: false,
    })
    const lines = new THREE.LineSegments(lineGeometry, lineMaterial)
    scene.add(lines)

    const mouse = new THREE.Vector2(0, 0)
    const startTime = performance.now()

    function updatePersona(nextPersona: Persona) {
      persona = nextPersona
      const accent = new THREE.Color(persona.accent)
      nodeMaterial.uniforms.uAccent.value.copy(accent)
      lineMaterial.uniforms.uAccent.value.copy(accent)
      ambientMaterial.uniforms.uAccent.value.copy(accent)
      nodeMaterial.uniforms.uIntensity.value = persona.background.intensity
      lineMaterial.uniforms.uIntensity.value = persona.background.intensity
      nodeMaterial.uniforms.uDensity.value = persona.background.density
      lineMaterial.uniforms.uDensity.value = persona.background.density
      ambientMaterial.uniforms.uIntensity.value = persona.background.intensity
      lineMaterial.uniforms.uDark.value = persona.mode === "dark" ? 1 : 0
      ambientMaterial.uniforms.uDark.value = persona.mode === "dark" ? 1 : 0
      document.documentElement.dataset.persona = persona.id
    }

    function handlePersonaChange(event: Event) {
      const nextPersona = (event as CustomEvent<Persona>).detail
      if (nextPersona?.accent && nextPersona?.background) updatePersona(nextPersona)
    }

    function handlePointerMove(event: PointerEvent) {
      mouse.x = ((event.clientX / window.innerWidth) * 2 - 1) * (worldWidth / 2)
      mouse.y = -((event.clientY / window.innerHeight) * 2 - 1) * (worldHeight / 2)
      nodeMaterial.uniforms.uMouse.value.copy(mouse)
      lineMaterial.uniforms.uMouse.value.copy(mouse)
      ambientMaterial.uniforms.uMouse.value.copy(mouse)
    }

    function resize() {
      if (!canvas) return
      renderer.setSize(canvas.clientWidth, canvas.clientHeight, false)
      camera.aspect = canvas.clientWidth / canvas.clientHeight
      camera.updateProjectionMatrix()
    }

    function render() {
      const elapsed = (performance.now() - startTime) / 1000
      nodeMaterial.uniforms.uTime.value = elapsed
      lineMaterial.uniforms.uTime.value = elapsed
      ambientMaterial.uniforms.uTime.value = elapsed
      renderer.render(scene, camera)
    }

    function syncLoop() {
      renderer.setAnimationLoop(!cleanedUp && visible && inViewport ? render : null)
    }

    function handleVisibilityChange() {
      visible = !document.hidden
      syncLoop()
    }

    const observer = new IntersectionObserver(([entry]) => {
      inViewport = entry.isIntersecting
      syncLoop()
    })
    observer.observe(canvas)

    window.addEventListener("persona-change", handlePersonaChange)
    window.addEventListener("pointermove", handlePointerMove, { passive: true })
    window.addEventListener("resize", resize)
    document.addEventListener("visibilitychange", handleVisibilityChange)
    window.addEventListener("pagehide", cleanup, { once: true })

    function cleanup() {
      if (cleanedUp) return
      cleanedUp = true
      renderer.setAnimationLoop(null)
      observer.disconnect()
      window.removeEventListener("persona-change", handlePersonaChange)
      window.removeEventListener("pointermove", handlePointerMove)
      window.removeEventListener("resize", resize)
      document.removeEventListener("visibilitychange", handleVisibilityChange)
      nodeGeometry.dispose()
      nodeMaterial.dispose()
      lineGeometry.dispose()
      lineMaterial.dispose()
      ambientGeometry.dispose()
      ambientMaterial.dispose()
      renderer.dispose()
    }

    resize()
    syncLoop()
  } catch {
    canvas.remove()
  }
}
</script>

<canvas
  id="three-canvas"
  class="pointer-events-none fixed inset-0 z-0 h-screen w-screen"
  style="will-change: transform"
  aria-hidden="true"
/>

<noscript>
  <div class="fixed inset-0 -z-10 bg-[radial-gradient(circle_at_center,rgba(255,107,0,0.16),transparent_45%)]"></div>
</noscript>
