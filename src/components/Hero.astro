---
import ProjectGraph from "./ProjectGraph.astro"
import { projects } from "../data/projects"
import { getFeaturedProjects } from "../lib/projectPresentation"

const homepageProjects = getFeaturedProjects(projects)
---

<section id="home-stage" class="home-minimal" aria-labelledby="home-title">
  <div class="home-minimal__top mono" aria-hidden="true">
    <span>sm / 01</span>
    <span>software engineer · toronto</span>
  </div>

  <div class="home-minimal__layout">
    <div class="home-minimal__copy">
      <div class="home-minimal__visual">
        <div class="home-minimal__portrait">
          <img src="/sayan-mohsin.svg" alt="Sayan Mohsin" width="1080" height="1080" />
        </div>
      </div>
      <span class="home-minimal__greeting">hey, i’m sayan.</span>
      <span class="home-minimal__welcome mono">senior software engineer · toronto</span>
      <h1 id="home-title">i build things worth shipping.</h1>
      <p>useful products, open-source tools, and experiments made with care.</p>
      <nav class="home-minimal__nav mono" aria-label="Homepage navigation">
          <a class="home-minimal__primary" href="/projects">see the work <span aria-hidden="true">↗</span></a>
        <a href="/about">about <span aria-hidden="true">↗</span></a>
        <a href="mailto:sayanmohsin@outlook.com">contact <span aria-hidden="true">↗</span></a>
      </nav>
    </div>

    <aside class="home-minimal__work" aria-label="Open source projects">
      <div class="home-minimal__work-heading mono"><span class="home-minimal__work-title">open source / selected work</span><span>{String(homepageProjects.length).padStart(2, "0")} projects</span></div>
      <ProjectGraph mode="home" projects={homepageProjects} />
      <a class="home-minimal__work-all mono" href="/projects">browse all projects <span aria-hidden="true">↗</span></a>
    </aside>
  </div>

  <div class="home-minimal__footer mono" aria-hidden="true">software / tools / experiments</div>
  <span class="home-minimal__swipe mono" aria-hidden="true">swipe up · see the work</span>
</section>

<script>
  const mobileSwipeQuery = window.matchMedia("(max-width: 760px) and (pointer: coarse)")
  const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)")
  let touchStart: { x: number; y: number } | null = null
  let navigating = false

  const handleTouchStart = (event: TouchEvent) => {
    if (!mobileSwipeQuery.matches || navigating || event.touches.length !== 1) return
    const touch = event.touches[0]
    touchStart = { x: touch.clientX, y: touch.clientY }
  }

  const handleTouchEnd = (event: TouchEvent) => {
    if (!mobileSwipeQuery.matches || navigating || !touchStart || event.changedTouches.length !== 1) return
    const touch = event.changedTouches[0]
    const deltaX = touch.clientX - touchStart.x
    const deltaY = touch.clientY - touchStart.y
    const startedOnControl = (event.target as HTMLElement | null)?.closest("a, button, input, textarea, select")
    touchStart = null

    if (startedOnControl || window.scrollY > 8 || deltaY > -72 || Math.abs(deltaY) < Math.abs(deltaX) * 1.2) return
    navigating = true
    if (reducedMotionQuery.matches) {
      window.location.assign("/projects")
      return
    }
    document.documentElement.classList.add("mobile-page-leaving")
    window.setTimeout(() => window.location.assign("/projects"), 280)
  }

  document.addEventListener("touchstart", handleTouchStart, { passive: true })
  document.addEventListener("touchend", handleTouchEnd, { passive: true })
</script>
