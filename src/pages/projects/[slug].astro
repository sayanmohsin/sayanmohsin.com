---
import Base from "../../layouts/Base.astro"
import ProjectDetailLayout from "../../layouts/ProjectDetail.astro"
import { projects } from "../../data/projects"

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }))
}

interface Props {
  project: (typeof projects)[number]
}

const { project } = Astro.props

const appSchemas: Record<string, Record<string, unknown>> = {
  clipbuf: {
    "@type": "SoftwareApplication",
    name: "clipbuf",
    operatingSystem: "macOS, Windows, Linux",
    applicationCategory: "UtilityApplication",
    description: "Privacy-first clipboard manager with full-text search, pinning, and paste-on-select for macOS, Windows, and Linux.",
    author: { "@type": "Person", name: "Sayan Mohsin" },
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  },
  thingd: {
    "@type": "SoftwareApplication",
    name: "thingd",
    operatingSystem: "macOS, Linux, Docker",
    applicationCategory: "DeveloperApplication",
    description: "Open-source Rust data engine with persistent storage, durable queues, event streams, full-text search, graph links, and MCP access.",
    author: { "@type": "Person", name: "Sayan Mohsin" },
  },
  "thingd-cloud": {
    "@type": "WebApplication",
    name: "thingd Cloud",
    applicationCategory: "BusinessApplication",
    description: "Private hosted-control-plane foundation for Thingd projects, MCP access, dashboards, and API-key management.",
    author: { "@type": "Person", name: "Sayan Mohsin" },
  },
  arqen: {
    "@type": "SoftwareApplication",
    name: "Arqen",
    applicationCategory: "DeveloperApplication",
    description: "Rust-first backend toolkit with typed tools, durable jobs, explicit HTTP boundaries, and optional Thingd adapters.",
    author: { "@type": "Person", name: "Sayan Mohsin" },
    programmingLanguage: "Rust",
    url: "https://sayanmohsin.github.io/arqen/",
    sameAs: ["https://github.com/sayanmohsin/arqen"],
  },
  "go-feather-route": {
    "@type": "SoftwareApplication",
    name: "Go Feather Route",
    operatingSystem: "Linux, Docker",
    applicationCategory: "DeveloperApplication",
    description: "Open-source Go gateway for routing OpenAI-compatible model requests with authentication, retries, timeouts, streaming, and operational health checks.",
    author: { "@type": "Person", name: "Sayan Mohsin" },
    programmingLanguage: "Go",
    license: "https://github.com/sayanmohsin/go-feather-route/blob/main/LICENSE",
    url: "https://sayanmohsin.github.io/go-feather-route/",
    sameAs: [
      "https://github.com/sayanmohsin/go-feather-route",
      "https://sayanmohsin.github.io/go-feather-route/",
      "https://hub.docker.com/r/sayanmohsin/go-feather-route",
    ],
  },
  dartcam: {
    "@type": "MobileApplication",
    name: "dartcam",
    operatingSystem: "Android, iOS",
    applicationCategory: "GameApplication",
    description: "Dart score calculator and automatic score detection app for iOS and Android with on-device AI.",
    author: { "@type": "Person", name: "Sayan Mohsin" },
  },
  "goodone-watch": {
    "@type": "SoftwareApplication",
    name: "GoodOne Watch",
    operatingSystem: "iOS, Android, Web",
    applicationCategory: "EntertainmentApplication",
    description: "A cross-platform assistant for finding and tracking movies and series across countries, streaming services, and languages.",
    author: { "@type": "Person", name: "Sayan Mohsin" },
    url: "https://goodone.watch",
    sameAs: ["https://github.com/sayanmohsin/goodone-watch"],
  },
}

const schema = appSchemas[project.slug]
  ? {
      ...appSchemas[project.slug],
      description: project.description,
      keywords: project.technologies.map((technology) => technology.name).join(", "),
      sameAs: project.links?.filter((link) => link.type === "github").map((link) => link.url),
    }
  : undefined

const metaDescription =
  project.description.length > project.tagline.length
    ? project.description
    : project.tagline
---

<Base
  title={`${project.name} — Sayan Mohsin`}
  description={metaDescription}
  canonical={`https://sayanmohsin.com/projects/${project.slug}`}
  ogType="article"
  schema={schema ? [schema] : undefined}
>
  <div class="min-h-screen">
    <ProjectDetailLayout project={project} />
  </div>
</Base>
